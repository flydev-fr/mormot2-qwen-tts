// mormot2-qwen-tts - SnakeBeta of the 12 Hz Qwen3-TTS decoder:
// y = x + invBeta[c] * sin(x * alpha[c])^2, alpha and invBeta precomputed
// (exp(alpha), 1 / (exp(beta) + 1e-9)); y may be x
// - our own sine: GLSL sin only guarantees an absolute precision of 2^-11,
//   and only on [-pi, pi]; here a Cody-Waite reduction by pi / 2, then the
//   Cephes polynomials (sinf, cosf): a few ulp
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer BufX { float x[]; };
layout(std430, binding = 1) buffer BufY { float y[]; };
layout(std430, binding = 2) readonly buffer BufA { float alpha[]; };
layout(std430, binding = 3) readonly buffer BufB { float invBeta[]; };

layout(push_constant) uniform Push {
  uint count, cols, xOff, yOff;
} p;

float sinAccurate(float v)
{
  // v = q * pi / 2 + r, |r| <= pi / 4, pi / 2 in three pieces; precise: the
  // driver must neither fuse nor reorder these subtractions
  float q = floor(v * 0.63661977236758134 + 0.5);
  precise float r = v - q * 1.5703125;
  r = r - q * 4.837512969970703125e-4;
  r = r - q * 7.549789948768648e-8;
  float z = r * r;
  float s = r + r * z * (-1.6666654611e-1 + z * (8.3321608736e-3 +
    z * -1.9515295891e-4));
  float c = 1.0 - 0.5 * z + z * z * (4.166664568298827e-2 + z *
    (-1.388731625493765e-3 + z * 2.443315711809948e-5));
  int n = int(q) & 3;
  if (n == 0)
    return s;
  if (n == 1)
    return c;
  if (n == 2)
    return -s;
  return -c;
}

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.count)
    return;
  uint c = i % p.cols;
  float v = x[p.xOff + i];
  float s = sinAccurate(v * alpha[c]);
  y[p.yOff + i] = v + invBeta[c] * (s * s);
}

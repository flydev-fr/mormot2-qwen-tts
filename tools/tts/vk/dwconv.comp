// mormot2-qwen-tts - causal per-channel convolution (kernel 7) of the ConvNeXt
// block of the 12 Hz Qwen3-TTS decoder: y[r, c] = b[c] + sum_k w[c, k] * x[r + k, c]
// - x: [6 history rows ; new rows], channels as columns
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufW { float w[]; };
layout(std430, binding = 2) readonly buffer BufB { float b[]; };
layout(std430, binding = 3) writeonly buffer BufY { float y[]; };

layout(push_constant) uniform Push {
  uint count, cols, xOff, yOff;
} p;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.count)
    return;
  uint r = i / p.cols;
  uint c = i - r * p.cols;
  float acc = b[c];
  for (uint k = 0u; k < 7u; k++)
    acc += w[c * 7u + k] * x[p.xOff + (r + k) * p.cols + c];
  y[p.yOff + i] = acc;
}
